meta {
  name: Get user token
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  client_id: {{keycloakClientId}}
  username: {{keycloakUserUsername}}
  password: {{keycloakUserPassword}}
  grant_type: password
}

tests {
  test("Keycloak returns a user access token", function() {
    if (res.status !== 200) {
      console.error("Keycloak token error (status " + res.status + "):", JSON.stringify(res.body));
    }
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
    expect(res.body.token_type).to.equal("Bearer");
    // Stocke dynamiquement le token dans l'environnement Bruno pour les requêtes suivantes
    bru.setEnvVar("userToken", res.body.access_token);
  });
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("userToken", res.body.access_token);
  }
}
