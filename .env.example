# =============================================================================
# ENV.EXAMPLE - MODÈLE DE CONFIGURATION DU PROJET
# =============================================================================
# Copiez ce fichier vers un nouveau fichier nommé '.env' sur votre machine locale :
#   cp .env.example .env (ou sous Windows : Copy-Item .env.example .env)
# 
# Le fichier '.env' est strictement ignoré par Git (.gitignore).
# Ne commitez jamais de vrais mots de passe ou secrets dans le dépôt !
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVEUR API EXPRESS (lu par src/server.ts)
# -----------------------------------------------------------------------------
# Port d'écoute HTTP local de l'API Node.js/Express.
PORT=8080

# -----------------------------------------------------------------------------
# 2. KEYCLOAK - SUPER ADMINISTRATEUR SYSTÈME (lu par docker-compose.yml & scripts/setup-keycloak-users.ts)
# -----------------------------------------------------------------------------
# Keycloak utilise ces variables au tout premier démarrage pour créer le compte 
# d'administration du Realm "master" (via KC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD).
# Ce compte sert ensuite à notre script 'npm run setup:keycloak' pour administrer
# Keycloak via son API REST d'administration.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-this-with-a-local-admin-password

# -----------------------------------------------------------------------------
# 3. KEYCLOAK - VALIDATION DES JETONS JWT (lu par src/auth.ts)
# -----------------------------------------------------------------------------
# URL publique du Realm du projet. L'API contacte l'endpoint JWKS 
# (${KEYCLOAK_ISSUER_URL}/protocol/openid-connect/certs) pour récupérer les clés 
# publiques et vérifier la signature des tokens Bearer envoyés dans les requêtes.
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/project-raph-oilhan

# Le jeton doit contenir l'audience API; les clients web et API la configurent dans Keycloak.
KEYCLOAK_AUDIENCE=project-api

# Origines exactes autorisées par CORS, séparées par des virgules.
# En production, utiliser uniquement les origines HTTPS réellement déployées.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origine publique exacte du frontend; utilisée par le provisionnement du client Keycloak.
WEB_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# 4. COMPTES DE TEST ÉPHÉMÈRES (lu par scripts/setup-keycloak-users.ts & Bruno)
# -----------------------------------------------------------------------------
# Ces variables définissent les identifiants créés dynamiquement dans le Realm
# 'project-raph-oilhan' pour permettre l'exécution des tests d'intégration Bruno.
#
# Compte utilisateur standard (rôle: 'user', email: user@example.com)
KEYCLOAK_USER_USERNAME=user1
KEYCLOAK_USER_PASSWORD=replace-with-a-test-user-password

# Compte administrateur applicatif (rôle: 'admin', email: admin@example.com)
KEYCLOAK_APP_ADMIN_USERNAME=admin
KEYCLOAK_APP_ADMIN_PASSWORD=replace-with-a-test-admin-password

# -----------------------------------------------------------------------------
# 5. ANTICIPATION BASE DE DONNÉES (PRISMA + POSTGRESQL)
# -----------------------------------------------------------------------------
# Chaîne de connexion à la base de données PostgreSQL.
# PostgreSQL local utilisé par Prisma.
POSTGRES_USER=devuser
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=appdb
DATABASE_URL="postgresql://devuser:replace-with-a-local-database-password@localhost:5432/appdb?schema=public"
